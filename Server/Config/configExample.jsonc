{
  "debug": false, //Debug printing
  "factionConfig": 
  {
    "killChangesRep": true, //If true, killing bots changes your rep
    "killRepDecrease": 0.005, //How much rep to lose from a faction for killing one of its members
    "killEnemyRep": 0.05 //How much rep to gain for killing a member of a rival faction
  },
  "battleConfig": 
  {
    "enableBattles": true, //Should the mod simulate battles? Turning this off will make the map static. 
    "allowBaseTaking": false, //If enabled, faction's home map is takeable which makes a faction getting wiped out possible
    "strengthDecreaseOverride": -1, //0.0 - 1.0 / Overrides the decrease of a faction's strength when moving locations. -1 for per faction configuration.
    "simulateAfterRaid": true, //If enabled, a battle simulation will trigger after a raid has completed. This guarentees the location will be simulated.
    "raidsChangeOutcome": true, //If enabled, the deaths of bots will contribute to damage taken during the simulated battle for the location
    "strengthLossPerDeath": 0.05, //0.0 - 1.0 / The damage that will be dealt to a faction per death in raid.
    "strengthLossPerBossDeath": 0.2, //0.0 - 1.0 / The damage that will be dealt to a faction per boss death in raid.
    "offlineSimulationTime": -1, //The delay between simulations in minutes. -1 to disable timed simulations.
    "actionsPerSimulation": 2, //How many actions can be taken per location i.e how many nearby locations can be taken.
    "locationsPerSimulation": 4, //How many locations to be simulated per activated simulation. The number wraps so 2 * the number of locations will simulate all locations twice.
    "attackNeutralChance": 25, //0 - 100 / The chance that a faction will try to engage in battle with another faction considered neutral
    "damageMultiplier": 1.25, //Multiplier for damage dealt in a battle
    "damageMinDistribution": -0.35, //Minimum rng change to a faction's damage in battle
    "damageMaxDistribution": 0.15, //Maximum rng change
    "strengthBuildup": 0.1, //0.0 - 1.0 / How much strength for factions to build up if their location is uncontested
    "maxStrengthBuildup": 0.6, //0.0 - 1.0 / Maximum strenth that can be gained from strength buildup
    "spreadMinStrength": 0.35, //0.0 - 1.0 / Minimum strength to spread to another location
    "spreadDecreaseMult": 0.15, //Multiplier to the strength decrease for moving locations to be applied to the original location
    "spreadBonusStrength": 0.1, //0.0 - 1.0 / Bonus strength given to new faction presence created by spreading.
    "uprising": true, //If enabled, certain factions have a chance of fighting at any location.
    "uprisingStrengthMult": 0.5 //Multiplier of a faction's base strength to grant for uprising appearances.
  },
  "raidConfig": 
  {
    "overridePmcs": false, //Remove pmc spawns from the map spawn pool
    "overrideBosses": false, //Remove all other bosses (includes raiders and rogues) from the map spawn pool
    "overrideTriggeredSpawns": false, //Remove all spawns that require a trigger to activate. i.e spawning raiders when opening the garage in labs
    "removeDefaultScavs": true, //Disable default scav spawn system
    "addFactionBosses": true, //Factions can spawn bosses in locations they have presence
    "factionBossMinStrength": 0.5, //0.0 - 1.0 / Minimum strength for a faction's boss spawns to be added to a location
    "factionBossMinChance": 25, //0 - 100 / Chance for a boss to spawn when a faction's strength is at minimum (0.0)
    "factionBossMaxChance": 50, //0 - 100 / Chance for a boss to spawn when a faction's strength is at maximum (100.0)
    "allyRepRequirement": 3, //Minimum reputation with a faction to be friendly
    "warnRepRequirement": 1, //Minimum reputation with a faction to be neutral
    "attitudeChangesAllies": true, //If true a faction's attitude with another faction changes their vanilla hostilities
    "playerRepAttitude": true, //If true a player's reputation with a faction will affect the bot's hostility towards the player
    "neutralityMode": 0, //0 - warn if neutral, 1 - true neutral, 2 - chance to be enemies
    "enemyChance": 50, //0 - 100 / If neutrality mode is 2, this sets the chance.
    "minStrengthWaveDelay": 350, //Delay at maximum strength (1.0) between wave spawns
    "maxStrengthWaveDelay": 500, //Delay at minimum strength (0.0)
    "delayVariance": 5, //RNG min and max variance added/subtracted to the wave spawns
    "maxWaves": 12, //Maximum waves that the mod will create for bots. -1 to disable the cap. HAVING THIS HIGH WITH A HIGH LENGTH RAID WILL CAUSE A MASSIVE SPIKE IN RAM USAGE!
    "minStrengthWaveSize": 5, //Bot spawns per wave at minimum strength (1.0)
    "maxStrengthWaveSize": 12, //Bot spawns per wave at maximum strength (0.0)
    "roundedBotCounts": true, //If false, bot groups will be cut off after hitting the bot count of the wave.
    "minStrengthGroupSize": 2, //Minimum bot size at minimum strength (0.0) if a group is created.
    "maxStrengthGroupSize": 4, //Maximum bot size at maximum strength (1.0)
    "groupSizeMinCount": 3, //How many chances does a group have to be minimum possible size
    "groupChance": 50, //Chance bots will spawn as a group
    "spawnEnd": 300, //Seconds before the end of a wave that spawning stops
    "initialBotMultiplier": 1.5, //Multiplier to wave bot count at the beginning of a raid
    "enforceBotSpawns": false, //If enabled, the mod tries to guarentee bot spawns. WARNING THIS CAN GET LAGGY QUICK
    "difficultyThresholds": //0.0 - 1.0 / Minimum strength for each bot difficulty
    {
      "impossible": 0.7,
      "hard": 0.4,
      "normal": 0.1,
      "easy": 0
    },
    "difficultyDecreaseChance": 25 //0 - 100 / Chance that a bot gets a lower difficulty than their strength level
  }
}