{
  "debug": false, //Debug printing
  "allowExpansionEdits": true, //Allow expansion mods to make config changes
  "oneTimeQuestRewards": true, //Don't give territories based quest rewards after the first completion. DOESN'T AFFECT REGULAR REWARDS, ONLY ONES FROM THIS MOD!
  "initialSimulations": 2, //How many battle simulations to run on a new save
  "factionConfig": 
  {
    "killChangesRep": true, //If true, killing bots changes your rep
    "killRepDecrease": 0.005, //How much rep to lose from a faction for killing one of its members
    "killEnemyRep": 0.05, //How much rep to gain for killing a member of a rival faction
    "overrideTraderRep": false //Should a faction's reputation change a player's standing with traders based on faction configuration
  },
  "battleConfig": 
  {
    "enableBattles": true, //Should the mod simulate battles? Turning this off will make the map static. 
    "allowBaseTaking": true, //If enabled, faction's home map is takeable which makes a faction getting wiped out possible
    "strengthDecreaseOverride": -1, //0.0 - 1.0 / Overrides the decrease of a faction's strength when moving locations. -1 for per faction configuration.
    "simulateAfterRaid": true, //If enabled, a battle simulation will trigger after a raid has completed. This guarantees the location will be simulated.
    "raidsChangeOutcome": true, //If enabled, the deaths of bots will contribute to damage taken during the simulated battle for the location
    "strengthLossPerDeath": 0.05, //0.0 - 1.0 / The damage that will be dealt to a faction per death in raid.
    "strengthLossPerBossDeath": 0.2, //0.0 - 1.0 / The damage that will be dealt to a faction per boss death in raid.
    "offlineSimulationTime": -1, //The delay between simulations in minutes. -1 to disable timed simulations.
    "actionsPerSimulation": 2, //How many actions can be taken per location i.e how many nearby locations can be taken.
    "locationsPerSimulation": 6, //How many locations to be simulated per activated simulation. The number wraps so 2 * the number of locations will simulate all locations twice.
    "attackNeutralChance": 25, //0 - 100 / The chance that a faction will try to engage in battle with another faction considered neutral
    "damageMultiplier": 0.6, //Multiplier for damage dealt in a battle
    "damageDistribution": 
    { //Min and max rng change to a faction's damage in battle
      "min": -0.25,
      "max": 0.25
    },
    "aggressivenessSpreadChance": 
    { //Chance a faction will spread and attack a new location based on its aggressiveness value. 
      "min": 30,
      "max": 100
    },
    "spreadWhileFighting": true, //Allows factions to spread and attack nearby locations without being the only contestant.
    "strengthBuildup": 0.05, //0.0 - 1.0 / How much strength for factions to build up if their location is uncontested, this values is capped by a faction's set value.
    "maxStrengthBuildup": 0.6, //0.0 - 1.0 / Maximum strength that can be gained from strength buildup
    "spreadMinStrength": 0.25, //0.0 - 1.0 / Minimum strength to spread to another location
    "spreadDecreaseMult": 0.15, //Multiplier to the strength decrease for moving locations to be applied to the original location
    "spreadBonusStrength": 0.15, //0.0 - 1.0 / Bonus strength given to new faction presence created by spreading.
    "uprising": true, //If enabled, certain factions have a chance of fighting at any location.
    "uprisingStrengthMult": 0.35 //Multiplier of a faction's base strength to grant for uprising appearances.
  },
  "raidConfig": 
  {
    "overridePmcs": false, //Remove pmc spawns from the map spawn pool
    "overrideCultists": true, //Remove all cultists from the spawn pool
    "overrideBosses": false, //Remove all other bosses (includes raiders and rogues) from the map spawn pool
    "overrideTriggeredSpawns": false, //Remove all spawns that require a trigger to activate. i.e spawning raiders when opening the garage in labs
    "removeDefaultScavs": true, //Disable default scav spawn system
    "addFactionBosses": true, //Factions can spawn bosses in locations they have presence
    "factionBossMinStrength": 0.6, //0.0 - 1.0 / Minimum strength for a faction's boss spawns to be added to a location
    "factionBossChance": 
    {
      "min": 15, //0 - 100 / Chance for a boss to spawn when a faction's strength is at minimum (0.0)
      "max": 25 //0 - 100 / Chance for a boss to spawn when a faction's strength is at maximum (100.0)
    },
    "allyRepRequirement": 3, //Minimum reputation with a faction to be friendly
    "warnRepRequirement": 1, //Minimum reputation with a faction to be neutral
    "attitudeChangesAllies": true, //If true a faction's attitude with another faction changes their vanilla hostilities
    "playerRepAttitude": true, //If true a player's reputation with a faction will affect the bot's hostility towards the player
    "neutralityMode": 1, //0 - warn if neutral, 1 - true neutral, 2 - chance to be enemies
    "overrideHostility": true, //Edit bot settings to be friendlier to allies
    "enemyChance": 50, //0 - 100 / If neutrality mode is 2, this sets the chance.
    "enforcePmcSpawns": false //If enabled, the mod tries to guarantee the PMC bot spawns of vanilla game. Doesn't guarantee faction PMCs and doesn't do anything if PMCs are overriden.
  },
  "spawnSettings": 
  {
    "perBotLoadout": 12, //How many loadouts to generate per expected bot spawns.
    "extraLoadouts": 8, //How many extra loadouts per bot type.
    "difficultyWeights": //Chances for a bot to be at a specific difficulty for a set difficulty threshold
    {
      "0.9": 
      {
        "Easy": 10,
        "Medium": 20,
        "Hard": 40,
        "Impossible": 30
      },
      "0.6": 
      {
        "Easy": 20,
        "Medium": 30,
        "Hard": 40,
        "Impossible": 10
      },
      "0.3": 
      {
        "Easy": 30,
        "Medium": 40,
        "Hard": 20,
        "Impossible": 10
      },
      "0": 
      {
        "Easy": 60,
        "Medium": 30,
        "Hard": 10,
        "Impossible": 0
      }
    },
    "strengthGroupSizeMin": //Min group size based on the faction's strength for the location.
    {
      "min": 2,
      "max": 4
    },
    "strengthGroupSizeMax": //Max group size based on the faction's strength for the location.
    {
      "min": 4,
      "max": 6
    },
    "strengthGroupChance": //Chance a group will spawn based on the faction's strength for the location.
    {
      "min": 20,
      "max": 80
    },
    "nonGroupBotModifier": 0.75, //Reduction modifier to bots waiting to spawn if it fails to form a group.
    "groupSpawnExclusive": false, //Should spawning a group not spawn some individual bots around the map in the same wave.
    "startTime": 1, //Time after the map starts to start spawning. Will still have a delay regardless.
    "stopTime": 200, //Time before the map ends to stop spawning.
    "requiredCapSpace": 4, //How many bots available beneath a faction's cap before spawning starts.
    "mapSettings": //Spawning settings per location 
    {
      "bigmap": 
      {
        "maxBots": 21, //Max territories-based bots
        "spawnOnWindow":  //Rng min and max length of the bot spawn windows in seconds.
        {
          "min": 80,
          "max": 120
        },
        "spawnOffWindow": //Rng min and max length of the time between bot spawn windows in seconds.
        {
          "min": 300,
          "max": 380
        }
      },
      "factory4_day": 
      {
        "maxBots": 12,
        "spawnOnWindow": 
        {
          "min": 60,
          "max": 100
        },
        "spawnOffWindow": 
        {
          "min": 300,
          "max": 380
        }
      },
      "interchange": 
      {
        "maxBots": 20,
        "spawnOnWindow": 
        {
          "min": 60,
          "max": 80
        },
        "spawnOffWindow": 
        {
          "min": 280,
          "max": 360
        }
      },
      "laboratory": 
      {
        "maxBots": 15,
        "spawnOnWindow": 
        {
          "min": 60,
          "max": 100
        },
        "spawnOffWindow": 
        {
          "min": 300,
          "max": 380
        }
      },
      "lighthouse": 
      {
        "maxBots": 20,
        "spawnOnWindow": 
        {
          "min": 80,
