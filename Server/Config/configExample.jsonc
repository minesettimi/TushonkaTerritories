        }
      },
      "rezervbase": 
      {
        "maxBots": 20,
        "spawnOnWindow": 
        {
          "min": 60,
          "max": 100
        },
        "spawnOffWindow": 
        {
          "min": 300,
          "max": 380
        }
      },
      "sandbox": 
      {
        "maxBots": 14,
        "spawnOnWindow": 
        {
          "min": 60,
          "max": 100
        },
        "spawnOffWindow": 
        {
          "min": 300,
          "max": 380
        }
      },
      "shoreline": {
        "maxBots": 21,
        "spawnOnWindow": 
        {
          "min": 80,
          "max": 120
        },
        "spawnOffWindow": 
        {
          "min": 300,
          "max": 380
        }
      },
      "tarkovstreets": 
      {
        "maxBots": 23,
        "spawnOnWindow": 
        {
          "min": 60,
          "max": 120
        },
        "spawnOffWindow": 
        {
          "min": 280,
          "max": 360
        }
      },
      "woods": 
      {
        "maxBots": 20,
        "spawnOnWindow": 
        {
          "min": 40,
          "max": 80
        },
        "spawnOffWindow": 
        {
          "min": 300,
          "max": 380
        }
      },
      "labyrinth": 
      {
        "maxBots": 10,
        "spawnOnWindow": 
        {
          "min": 60,
          "max": 100
        },
        "spawnOffWindow": 
        {
          "min": 300,
          "max": 380
        }
      },
      "icebreaker": 
      {
        "maxBots": 18,
        "spawnOnWindow": 
        {
          "min": 60,
          "max": 100
        },
        "spawnOffWindow": 
        {
          "min": 300,
          "max": 380
        }
      },
      "terminal": 
      {
        "maxBots": 18,
        "spawnOnWindow": 
        {
          "min": 60,
          "max": 100
        },
        "spawnOffWindow": 
        {
          "min": 300,
          "max": 380
        }
      }
    },
    "softCapSpace": 4, //Cap below the total max bot count to stop spawning bots.
    "spawnCheckInterval": 20, //Interval between trying to spawn bots. Lower numbers means more bots and lag, be careful.
    "spawnDelayAdjustmentMax": 2, //Max rng time to add to the bot to delay their spawn.
    "maxBotSpawnsPerInterval": 8, //Cap of bots to spawn per spawn interval
    "deadRaidThreshold": 4, //How many bots in the raid to be considered dead
    "deadRaidTimer": 15 //Overrides the spawn window off time to this time when the raid is considered dead
  }
}